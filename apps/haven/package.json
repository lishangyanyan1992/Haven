    "langfuse": "^3",
    "lucide-react": "^1.30.0",
    "mixpanel-browser": "^2.81.0",
    "next": "^16.3.0",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "posthog-node": "^5.48.1",
