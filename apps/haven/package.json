{
  "name": "@haven/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:guardrails": "tsx --tsconfig tsconfig.json evals/advisor/check-guardrails.ts",
    "eval:advisor": "tsx --tsconfig tsconfig.json evals/advisor/run-local.ts",
    "check:stale-bulletin": "tsx --tsconfig tsconfig.json evals/advisor/stale-bulletin.check.ts",
    "check:travel-gate": "tsx --tsconfig tsconfig.json evals/advisor/travel-gate.check.ts",
    "check:memory": "tsx --tsconfig tsconfig.json evals/advisor/memory.check.ts",
